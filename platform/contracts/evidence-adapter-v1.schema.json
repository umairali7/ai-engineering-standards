{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aies.example/contracts/evidence-adapter-v1.schema.json",
  "title": "AIES Evidence Adapter Declaration v1 (experimental)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "profile", "version", "source", "modalities",
    "event_types", "completeness", "decision_use", "scoring_semantics",
    "duplicate_identity", "privacy", "loss_report_required",
    "decision_products", "limitations"],
  "properties": {
    "contract": {"const": "aies-evidence-adapter/v1"},
    "profile": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["format", "versions"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "modalities": {"type": "array", "minItems": 1},
    "event_types": {"type": "array", "minItems": 1},
    "completeness": {"enum": ["complete", "partial", "profile-bounded"]},
    "decision_use": {
      "enum": ["informational-only", "engineering-evaluation",
        "formal-qualification"]
    },
    "scoring_semantics": {"type": "string", "minLength": 1},
    "duplicate_identity": {
      "const": "source_digest + source_record_id + adapter_profile"
    },
    "privacy": {"type": "object"},
    "loss_report_required": {"const": true},
    "decision_products": {"type": "array"},
    "limitations": {"type": "array", "minItems": 1}
  }
}
