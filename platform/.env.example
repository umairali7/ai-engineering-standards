# AIES platform — operational configuration.
#
# Copy to `.env` (which is git-ignored) and edit, or export these as real
# environment variables. Real environment variables always win over .env.
# The platform loads the first .env found in: $AIES_ENV_FILE, ./.env,
# then <workspace>/.env.
#
# NOTE: only OPERATIONAL settings live here. The normative engine constants
# — gates, dimension weights, sample-size minimums, confidence level, the
# reviewer calibration threshold — are the AESQS standard and are NOT
# configurable by design (a configurable gate is no gate; PLATFORM.md D3).

# Where the platform writes its artifacts (registry, runs, records, index).
# Default: ./aies-workspace
AIES_WORKSPACE=./aies-workspace

# Endpoints for the built-in runtime adapters. Each named runtime has a
# conventional default port (shown), so you usually need NOT set these — the
# adapter uses the default and `aies discover` finds a running server. Set one
# only to override the port or to reach a remote/hosted endpoint.
#   AIES_OLLAMA_BASE_URL     default http://localhost:11434/v1   (Ollama)
#   AIES_LMSTUDIO_BASE_URL   default http://localhost:1234/v1    (LM Studio)
#   AIES_LLAMACPP_BASE_URL   default http://localhost:8080/v1    (llama.cpp)
#   AIES_MLX_BASE_URL        default http://localhost:8080/v1    (MLX)
# AIES_OLLAMA_BASE_URL=http://localhost:11434/v1

# Generic openai-compat runtime (anything else, incl. hosted APIs). No
# conventional default — unset means "not configured".
# AIES_OPENAI_BASE_URL=https://your-endpoint/v1

# API key for the openai-compat endpoint, if it requires one. A deployment
# manifest MAY instead name its own env var via runtime_config.api_key_env.
# AIES_OPENAI_API_KEY=

# Path to a specific .env file (overrides the default search).
# AIES_ENV_FILE=

# --- generation defaults (a deployment's parameters_default overrides these) ---
# Per-request inference timeout in seconds. Default: 300
AIES_REQUEST_TIMEOUT_S=300
# Connect timeout (seconds) for the quick runtime liveness probe used by
# `aies doctor` / `aies discover`. Default: 3
AIES_PROBE_TIMEOUT_S=3
# Default concurrent inference calls for `aies qualify` (--parallel overrides).
# Default: 1
AIES_PARALLEL=1
# Default judge deployment for automated scoring (`aies qualify` auto-scores
# and prints the report, no manual step). Set to a deployment id, or "self"
# to have the candidate score its own output (biased — a separate judge is
# strongly preferred). --judge overrides this. Unset = manual scoring.
# AIES_JUDGE=judge-model
# Sampling controls sent to the runtime when set (omit to use the model default).
# AIES_TEMPERATURE=0.6
# AIES_MAX_TOKENS=4096
# AIES_TOP_P=1.0
# AIES_SEED=
